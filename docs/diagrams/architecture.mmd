%% incidentd component architecture
flowchart TB
  classDef ext fill:#eef2ff,stroke:#6366f1,color:#111
  classDef core fill:#fff7ed,stroke:#ea580c,color:#111
  classDef eng fill:#f0fdf4,stroke:#16a34a,color:#111
  classDef store fill:#f1f5f9,stroke:#475569,color:#111
  classDef warn fill:#fef2f2,stroke:#dc2626,color:#111

  subgraph In[" "]
    direction LR
    SLK["Slack<br/>/incident + buttons"]:::ext
    TMS["Microsoft Teams<br/>@IncidentBot (optional)"]:::ext
    PDW["PagerDuty<br/>Webhooks v3"]:::ext
    MPX["Multiplexer<br/>SLO guardrails"]:::ext
  end

  subgraph incidentd["incidentd (Go, single service)"]
    direction TB
    subgraph edge[" "]
      direction LR
      CHAT["chat/slack · chat/teams<br/>signature / JWT verification<br/>ack < 3 s · async reply"]:::core
      ING["ingest/<br/>PD webhook · Multiplexer poller<br/>dedupe · change detection"]:::core
    end
    CORE["core/<br/>state machine · severity policy · commands + RBAC<br/>hash-chained timeline · cadence nudges · metrics hooks"]:::core
    subgraph engines[" "]
      direction LR
      TRI["triage/<br/>Claude agent loop · read-only tools<br/>redaction · citation + catalog checks"]:::eng
      REM["remediation/<br/>catalog · approval policy<br/>dry-run · 2-key kill switch"]:::warn
      PM["postmortem/<br/>TTD/TTA/TTM/TTR · budget burned<br/>BM25 similar incidents · draft"]:::eng
    end
    PROV["providers/ (ports & adapters)<br/>pagerduty · datadog · jira · kubernetes · multiplexer · anthropic · stubs"]:::core
    MET["metrics/ → :9090 /metrics (internal)"]:::core
  end

  subgraph Down["Downstream APIs"]
    direction LR
    PD2["PagerDuty REST"]:::ext
    DD["Datadog API<br/>(read-only)"]:::ext
    JR["Jira Cloud"]:::ext
    K8S["Kubernetes API<br/>(read-only RBAC)"]:::ext
    LLM["Anthropic API<br/>claude-opus-5-5"]:::ext
  end
  PG[("PostgreSQL<br/>dedicated schema<br/>append-only timeline")]:::store
  MON["Prometheus / Grafana<br/>or Datadog Agent"]:::ext

  SLK <--> CHAT
  TMS <--> CHAT
  PDW -- signed POST --> ING
  ING -- "poll /api/slo-guardrails" --> MPX
  CHAT --> CORE
  ING --> CORE
  CORE --> TRI & REM & PM
  CORE <--> PG
  TRI & REM & PM --> PROV
  CORE --> PROV
  PROV --> Down
  MON -. scrape .-> MET
