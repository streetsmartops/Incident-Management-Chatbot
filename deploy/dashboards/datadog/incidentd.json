{
  "description": "Generated by deploy/dashboards/gen_dashboards.py. Requires the OpenMetrics annotation in deploy/k8s/deployment.yaml.",
  "layout_type": "ordered",
  "notify_list": [],
  "reflow_type": "fixed",
  "template_variables": [],
  "title": "incidentd: Incident Management Bot",
  "widgets": [
    {
      "definition": {
        "autoscale": true,
        "precision": 0,
        "requests": [
          {
            "aggregator": "last",
            "q": "sum:incidentd.incidents_open{*}"
          }
        ],
        "title": "Open incidents",
        "type": "query_value"
      },
      "layout": {
        "height": 2,
        "width": 2,
        "x": 0,
        "y": 0
      }
    },
    {
      "definition": {
        "autoscale": true,
        "precision": 0,
        "requests": [
          {
            "aggregator": "last",
            "q": "sum:incidentd.incidents_open{severity:sev1 OR severity:sev2}"
          }
        ],
        "title": "Open SEV1/SEV2",
        "type": "query_value"
      },
      "layout": {
        "height": 2,
        "width": 2,
        "x": 2,
        "y": 0
      }
    },
    {
      "definition": {
        "autoscale": true,
        "precision": 0,
        "requests": [
          {
            "aggregator": "last",
            "q": "sum:incidentd.incidents_declared.count{*}.as_count()"
          }
        ],
        "title": "Declared (window)",
        "type": "query_value"
      },
      "layout": {
        "height": 2,
        "width": 2,
        "x": 4,
        "y": 0
      }
    },
    {
      "definition": {
        "autoscale": true,
        "precision": 0,
        "requests": [
          {
            "aggregator": "last",
            "q": "max:incidentd.remediation_executor_enabled{*}"
