        ],
        "title": "Remediation executor",
        "type": "query_value"
      },
      "layout": {
        "height": 2,
        "width": 2,
        "x": 6,
        "y": 0
      }
    },
    {
      "definition": {
        "requests": [
          {
            "display_type": "line",
            "q": "sum:incidentd.incidents_open{*} by {severity}"
          }
        ],
        "title": "Open incidents by severity",
        "type": "timeseries"
      },
      "layout": {
        "height": 2,
        "width": 4,
        "x": 0,
        "y": 2
