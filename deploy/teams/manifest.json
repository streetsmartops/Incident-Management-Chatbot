{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "00000000-0000-0000-0000-000000000000",
  "developer": {
    "name": "Platform SRE",
    "websiteUrl": "https://incidentd.example.com",
    "privacyUrl": "https://incidentd.example.com/privacy",
    "termsOfUseUrl": "https://incidentd.example.com/terms"
  },
  "name": {"short": "Incident Bot", "full": "Incident Management Bot"},
  "description": {
    "short": "Declare, coordinate, triage and learn from incidents.",
    "full": "Mention @IncidentBot followed by a command: declare, sev, role, status, update, triage, run, resolve, postmortem, timeline. Outside a war room add --incident INC-YYYY-NNNN."
  },
  "icons": {"color": "color.png", "outline": "outline.png"},
  "accentColor": "#B22222",
  "bots": [
    {
      "botId": "00000000-0000-0000-0000-000000000000",
      "scopes": ["team", "groupChat", "personal"],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {"scopes": ["team", "groupChat"], "commands": [
          {"title": "declare", "description": "declare \"<title>\" --sev 1-4"},
          {"title": "status", "description": "status [investigating|identified|mitigating|monitoring] --incident KEY"},
          {"title": "triage", "description": "Run read-only AI triage --incident KEY"},
          {"title": "timeline", "description": "Show the timeline --incident KEY"}
        ]}
      ]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["incidentd.example.com"]
}
